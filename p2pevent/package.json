{
  "name": "p2pevent",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build nodo && nest build servidor",
    "build:nodo": "nest build nodo",
    "build:servidor": "nest build servidor",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "servidor": "cross-env SERVER_PORT=3000 nest start servidor --watch",
    "nodo1": "cross-env PORT=3001 PEER_ID=nodo-3001 USER_ID=1 ZONE_ID=1 node dist/apps/nodo/main",
    "nodo2": "cross-env PORT=3002 PEER_ID=nodo-3002 USER_ID=2 ZONE_ID=1 node dist/apps/nodo/main",
    "nodo3": "cross-env PORT=3003 PEER_ID=nodo-3003 USER_ID=3 ZONE_ID=1 node dist/apps/nodo/main",
    "nodo4": "cross-env PORT=3004 PEER_ID=nodo-3004 USER_ID=4 ZONE_ID=1 node dist/apps/nodo/main",
    "nodo:dev": "cross-env PORT=3001 PEER_ID=nodo-3001 nest start nodo --watch",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
